{
  "info": {
    "_postman_id": "healthcare-crm-api-v1",
    "name": "HealthCare CRM API",
    "description": "Complete Postman collection for Healthcare CRM REST API.\n\nBase URL: http://localhost:5000\n\nAuthentication: Use the Login endpoint to get a JWT token, then set it as Bearer token in Authorization header.\n\n## Track A - Appointments\n- Full CRUD endpoints\n- Double-booking conflict check (returns 409)\n- Filtered query by date and doctorId\n\n## Track B - Emergency\n- Mock location endpoint GET /api/emergency/{id}/location",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.token) {",
                  "    pm.collectionVariables.set('token', json.token);",
                  "    pm.test('Token saved', () => pm.expect(json.token).to.be.a('string'));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@healthcare.com\",\n  \"password\": \"Admin@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"New User\",\n  \"email\": \"newuser@healthcare.com\",\n  \"password\": \"User@123\",\n  \"role\": \"Staff\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Track A - Appointments",
      "item": [
        {
          "name": "GET All Appointments",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/appointments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "appointments"
              ]
            }
          }
        },
        {
          "name": "GET Appointments (filter by status)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/appointments?status=Scheduled",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "appointments"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "Scheduled"
                }
              ]
            }
          }
        },
        {
          "name": "GET Appointments (filter by date + doctorId) [Track A]",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/appointments?date=2025-06-29&doctorId=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "appointments"
              ],
              "query": [
                {
                  "key": "date",
                  "value": "2025-06-29",
                  "description": "Filter by appointment date (yyyy-MM-dd)"
                },
                {
                  "key": "doctorId",
                  "value": "1",
                  "description": "Filter by Doctor ID"
                }
              ]
            },
            "description": "Track A feature: Filter appointments by date and doctorId.\n\nExample: GET /api/appointments?date=2025-06-29&doctorId=1"
          }
        },
        {
          "name": "GET Appointment by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/appointments/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "appointments",
                "1"
              ]
            }
          }
        },
        {
          "name": "POST Create Appointment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patientId\": 1,\n  \"doctorId\": 1,\n  \"appointmentDate\": \"2025-07-15T10:00:00\",\n  \"reason\": \"Routine checkup\",\n  \"status\": \"Scheduled\",\n  \"notes\": \"First visit\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/appointments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "appointments"
              ]
            },
            "description": "Creates a new appointment.\n\n\u2705 Returns 201 Created on success.\n\u274c Returns 409 Conflict if the same doctor already has an appointment at the exact same date and time (double-booking protection).\n\u274c Returns 400 Bad Request if PatientId or DoctorId is invalid."
          }
        },
        {
          "name": "POST Create Appointment (Double-Booking Test - Expect 409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patientId\": 2,\n  \"doctorId\": 1,\n  \"appointmentDate\": \"2025-07-15T10:00:00\",\n  \"reason\": \"Follow-up\",\n  \"status\": \"Scheduled\",\n  \"notes\": \"This should return 409 Conflict\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/appointments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "appointments"
              ]
            },
            "description": "\u26a0\ufe0f Test case for double-booking conflict.\n\nIf Doctor 1 already has an appointment on 2025-07-15 at 10:00, this request should return:\n\n409 Conflict\n{\n  \"message\": \"Doctor already has an appointment at this date and time.\"\n}"
          }
        },
        {
          "name": "PUT Update Appointment",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patientId\": 1,\n  \"doctorId\": 1,\n  \"appointmentDate\": \"2025-07-15T11:00:00\",\n  \"reason\": \"Follow-up visit\",\n  \"status\": \"Scheduled\",\n  \"notes\": \"Rescheduled to 11 AM\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/appointments/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "appointments",
                "1"
              ]
            },
            "description": "Updates an appointment.\n\n\u2705 Returns 200 OK on success.\n\u274c Returns 409 Conflict if the updated time conflicts with another appointment for the same doctor."
          }
        },
        {
          "name": "DELETE Appointment",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/appointments/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "appointments",
                "1"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Track B - Emergency",
      "item": [
        {
          "name": "GET Emergency Location by ID [Track B]",
          "request": {
            "method": "GET",
            "header": [
