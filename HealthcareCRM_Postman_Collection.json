            "url": {
              "raw": "{{baseUrl}}/api/emergency/1/location",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "emergency",
                "1",
                "location"
              ]
            },
            "description": "Track B feature: Mock endpoint that returns the real-time location of an emergency case.\n\nReturns:\n- EmergencyId\n- PatientName\n- Status (Active / Resolved)\n- Location (Latitude, Longitude, Address, Floor, Ward)\n- RespondingUnit\n- DispatchedAt\n- EstimatedArrivalMinutes\n\nTry IDs 1, 2, or any positive integer for mock data."
          }
        },
        {
          "name": "GET Emergency Location (ID 2)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/emergency/2/location",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "emergency",
                "2",
                "location"
              ]
            }
          }
        }
      ]
