@model List<Patient>
@{
    ViewData["Title"] = "Patients";
    var search = ViewBag.Search as string;
}

<div id="loadingSpinner" style="text-align:center; padding:40px;">
    <div class="spinner" style="width:36px; height:36px; border:4px solid #e0e0e0; border-top-color:#2563eb; border-radius:50%; margin:0 auto; animation: spin 0.8s linear infinite;"></div>
    <p style="color:#888; margin-top:12px; font-size:13px;">Loading patients...</p>
</div>

<style>
    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }
</style>

<div id="patientContent" style="display:none;">

    <div class="page-head">
        <div>
            <h2>Patients</h2>
            <div class="sub">@Model.Count patient(s) registered</div>
        </div>
        <a asp-action="AddEdit" class="btn btn-primary">+ Add Patient</a>
    </div>

    <form asp-action="Index" method="get" class="toolbar">
        <div class="search-group">
            <input type="text" name="search" value="@search" placeholder="Search by name or email..." />
            <button type="submit" class="btn btn-primary">Search</button>
        </div>
        @if (!string.IsNullOrEmpty(search))
        {
            <a asp-action="Index" class="btn btn-secondary">Clear</a>
        }
    </form>

    <div class="table-card">
        @if (Model.Any())
        {
            <table class="table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Gender</th>
                        <th>Age</th>
                        <th>Status</th>
                        <th style="text-align:right;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td class="cell-strong">@p.FullName</td>
                            <td>@p.Email</td>
                            <td>@(string.IsNullOrEmpty(p.PhoneNumber) ? "—" : p.PhoneNumber)</td>
                            <td>@(string.IsNullOrEmpty(p.Gender) ? "—" : p.Gender)</td>
                            <td>@(DateTime.Today.Year - p.DateOfBirth.Year - (DateTime.Today.DayOfYear < p.DateOfBirth.DayOfYear ? 1 : 0))</td>
                            <td>
                                @if (p.IsActive)
                                {
                                    <span class="badge-status active">Active</span>
                                }
                                else
                                {
                                    <span class="badge-status inactive">Inactive</span>
                                }
                            </td>
                            <td style="text-align:right;">
                                <div class="action-group">
                                    <a asp-action="AddEdit" asp-route-id="@p.Id" class="btn btn-outline btn-sm">Edit</a>
                                    <form asp-action="Delete" asp-route-id="@p.Id" method="post"
                                          onsubmit="return confirm('Remove this patient?');">
                                        <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-ico">☺</div>
                <h4>No patients found</h4>
                <p>@(string.IsNullOrEmpty(search) ? "Start by adding your first patient." : "Try a different search term.")</p>
                <a asp-action="AddEdit" class="btn btn-primary">+ Add Patient</a>
            </div>
        }
    </div>

</div>

<script>
    window.addEventListener('DOMContentLoaded', function() {
        setTimeout(function() {
            document.getElementById('loadingSpinner').style.display = 'none';
            document.getElementById('patientContent').style.display = 'block';
        }, 400);
    });
</script>