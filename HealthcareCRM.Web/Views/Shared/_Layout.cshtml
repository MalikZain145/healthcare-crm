@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    string Active(string c) => string.Equals(controller, c, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    string ActiveAction(string c, string a) =>
        (string.Equals(controller, c, StringComparison.OrdinalIgnoreCase)
         && string.Equals(action, a, StringComparison.OrdinalIgnoreCase)) ? "active" : "";

    var userName = User.Identity?.Name ?? "User";
    var initials = string.Join("", userName.Split(' ', StringSplitOptions.RemoveEmptyEntries)
                       .Take(2).Select(s => char.ToUpper(s[0])));
    var isAdmin = User.IsInRole("Admin");
    var isDoctor = User.IsInRole("Doctor");
    var isPatient = User.IsInRole("Patient");
    var roleLabel = isAdmin ? "Administrator" : isDoctor ? "Doctor" : isPatient ? "Patient" : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · HealthCare CRM</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="app-body">
    <div class="app-shell">
        <!-- Sidebar -->
        <aside class="sidebar" id="sidebar">
            <div class="sidebar-brand">
                <span class="brand-logo">✚</span>
                <span class="brand-text">HealthCare<span class="brand-accent">CRM</span></span>
            </div>
            <nav class="sidebar-nav">
                @if (isAdmin)
                {
                    <a class="nav-link @Active("Dashboard")" asp-controller="Dashboard" asp-action="Index"><span class="nav-ico">▦</span> Dashboard</a>
                    <a class="nav-link @Active("Patients")" asp-controller="Patients" asp-action="Index"><span class="nav-ico">☺</span> Patients</a>
                    <a class="nav-link @Active("Doctors")" asp-controller="Doctors" asp-action="Index"><span class="nav-ico">✦</span> Doctors</a>
                    <a class="nav-link @Active("Appointments")" asp-controller="Appointments" asp-action="Index"><span class="nav-ico">▤</span> Appointments</a>
                    <a class="nav-link @Active("Billing")" asp-controller="Billing" asp-action="Index"><span class="nav-ico">₨</span> Billing</a>
                    <a class="nav-link @Active("Reports")" asp-controller="Reports" asp-action="Index"><span class="nav-ico">◷</span> Reports</a>
                }
                else if (isDoctor)
                {
                    <a class="nav-link @Active("Dashboard")" asp-controller="Dashboard" asp-action="Index"><span class="nav-ico">▦</span> Dashboard</a>
                    <a class="nav-link @Active("Patients")" asp-controller="Patients" asp-action="Index"><span class="nav-ico">☺</span> My Patients</a>
                    <a class="nav-link @Active("Appointments")" asp-controller="Appointments" asp-action="Index"><span class="nav-ico">▤</span> My Appointments</a>
                }
                else if (isPatient)
                {
                    <a class="nav-link @ActiveAction("Portal","Index")" asp-controller="Portal" asp-action="Index"><span class="nav-ico">▦</span> My Dashboard</a>
                    <a class="nav-link @ActiveAction("Portal","Appointments")" asp-controller="Portal" asp-action="Appointments"><span class="nav-ico">▤</span> My Appointments</a>
                    <a class="nav-link @ActiveAction("Portal","Invoices")" asp-controller="Portal" asp-action="Invoices"><span class="nav-ico">₨</span> My Invoices</a>
                    <a class="nav-link @ActiveAction("Portal","Profile")" asp-controller="Portal" asp-action="Profile"><span class="nav-ico">☺</span> My Profile</a>
                }
            </nav>
            <div class="sidebar-footer">
                <div class="muted-small">Signed in as</div>
                <div class="sidebar-user">@userName</div>
                @if (!string.IsNullOrEmpty(roleLabel))
                {
                    <span class="badge-pill b-blue" style="margin-top:6px;display:inline-block;">@roleLabel</span>
                }
            </div>
        </aside>

        <!-- Main -->
        <div class="app-main">
            <header class="topbar">
                <button class="hamburger" type="button" onclick="document.getElementById('sidebar').classList.toggle('open')">☰</button>
                <h1 class="topbar-title">@ViewData["Title"]</h1>
                <div class="topbar-right">

                    <div class="notif-bell-wrap">
                        <button type="button" class="btn-bell" id="notifBellBtn" title="Notifications">
                            🔔
                            <span id="notifBadge" class="notif-badge" style="display:none;">0</span>
                        </button>
                        <div id="notifPanel" class="notif-panel" style="display:none;">
                            <div class="notif-panel-head">Notifications</div>
                            <div id="notifPanelList" class="notif-panel-list">
                                <div class="notif-empty">Loading…</div>
                            </div>
                            <a asp-controller="Notifications" asp-action="Index" class="notif-panel-footer">View all</a>
                        </div>
                    </div>

                    <div class="avatar" title="@userName">@initials</div>

                    <form asp-controller="Account" asp-action="Logout" method="post" class="logout-form">
                        <button type="submit" class="btn-logout">Sign out</button>
                    </form>

                </div>
            </header>

            <main class="content">
                @if (TempData["Success"] != null)
                {
                    <div class="toast-msg success">@TempData["Success"]</div>
                }
                @RenderBody()
            </main>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        (function () {
        const bellBtn = document.getElementById('notifBellBtn');
        const panel = document.getElementById('notifPanel');
        const badge = document.getElementById('notifBadge');
        const list = document.getElementById('notifPanelList');
        if (!bellBtn) return;

        function timeAgo(dateStr) {
        const diffMs = Date.now() - new Date(dateStr).getTime();
        const mins = Math.floor(diffMs / 60000);
        if (mins < 1) return 'just now';
        if (mins < 60) return mins + 'm ago';
        const hrs = Math.floor(mins / 60);
        if (hrs < 24) return hrs + 'h ago';
        return Math.floor(hrs / 24) + 'd ago';
        }

        function render(data) {
        if (data.count > 0) {
        badge.textContent = data.count > 9 ? '9+' : data.count;
        badge.style.display = 'flex';
        } else {
        badge.style.display = 'none';
        }

        if (!data.items || data.items.length === 0) {
        list.innerHTML = '<div class="notif-empty">No unread notifications.</div>';
        return;
        }

        list.innerHTML = '';
        data.items.forEach(function (n) {
        const item = document.createElement('div');
        item.className = 'notif-item';
        item.innerHTML =
        '<div class="notif-title">' + n.title + '</div>' +
        '<div class="notif-msg">' + n.message + '</div>' +
        '<div class="notif-time">' + timeAgo(n.createdAt) + '</div>';
        item.addEventListener('click', function () { handleClick(n); });
        list.appendChild(item);
        });
        }

        function loadNotifications() {
        fetch('/Notifications/GetUnreadJson')
        .then(function (r) { return r.json(); })
        .then(render)
        .catch(function () {
        list.innerHTML = '<div class="notif-empty">Could not load notifications.</div>';
        });
        }

        function handleClick(n) {
        const form = new FormData();
        form.append('id', n.id);
        fetch('/Notifications/MarkAsReadAjax', { method: 'POST', body: form })
        .finally(function () {
        if (n.type === 'Appointment' && n.relatedEntityId) {
        window.location.href = '/Appointments/Details/' + n.relatedEntityId;
        } else {
        window.location.href = '/Notifications';
        }
        });
        }

        bellBtn.addEventListener('click', function (e) {
        e.stopPropagation();
        const opening = panel.style.display === 'none';
        panel.style.display = opening ? 'flex' : 'none';
        if (opening) loadNotifications();
        });

        document.addEventListener('click', function (e) {
        if (!panel.contains(e.target) && e.target !== bellBtn) {
        panel.style.display = 'none';
        }
        });

        loadNotifications();
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
    
       
</html>
