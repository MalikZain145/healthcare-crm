@model DashboardViewModel
@{
    ViewData["Title"] = "Reports";
    int scheduled = ViewBag.Scheduled ?? 0;
    int completed = ViewBag.Completed ?? 0;
    int cancelled = ViewBag.Cancelled ?? 0;
    int paid = ViewBag.PaidCount ?? 0;
    int unpaid = ViewBag.UnpaidCount ?? 0;
    int apptTotal = scheduled + completed + cancelled;
    int invTotal = paid + unpaid;
    decimal total = Model.TotalRevenue + Model.OutstandingAmount;
    int Pct(int part, int whole) => whole == 0 ? 0 : (int)Math.Round(part * 100.0 / whole);
}

<div class="page-head">
    <div>
        <h2>Reports &amp; Analytics</h2>
        <div class="sub">Overview of clinic activity</div>
    </div>
</div>

@if (ViewBag.LoadError == true)
{
    <div class="alert-box error">Could not load report data. Please try again later.</div>
}

<div class="stat-grid">
    <div class="stat-card">
        <div class="stat-ico teal">☺</div>
        <div class="stat-value">@Model.TotalPatients</div>
        <div class="stat-label">Total Patients</div>
    </div>
    <div class="stat-card">
        <div class="stat-ico navy">✦</div>
        <div class="stat-value">@Model.TotalDoctors</div>
        <div class="stat-label">Active Doctors</div>
    </div>
    <div class="stat-card">
        <div class="stat-ico amber">▤</div>
        <div class="stat-value">@Model.TotalAppointments</div>
        <div class="stat-label">Total Appointments</div>
    </div>
    <div class="stat-card">
        <div class="stat-ico green">₨</div>
        <div class="stat-value">Rs @total.ToString("N0")</div>
        <div class="stat-label">Total Billed</div>
    </div>
</div>

<div class="dash-cols">
    <div class="panel">
        <div class="panel-head">Appointments by status</div>
        <div class="panel-body" style="padding:18px 22px;">
            <div style="margin-bottom:16px;">
                <div style="display:flex;justify-content:space-between;font-size:14px;margin-bottom:6px;">
                    <span><span class="badge-pill b-blue">Scheduled</span></span><strong>@scheduled (@Pct(scheduled, apptTotal)%)</strong>
                </div>
                <div style="height:8px;background:#eef1f5;border-radius:999px;overflow:hidden;">
                    <div style="height:100%;width:@Pct(scheduled, apptTotal)%;background:var(--navy-700);"></div>
                </div>
            </div>
            <div style="margin-bottom:16px;">
                <div style="display:flex;justify-content:space-between;font-size:14px;margin-bottom:6px;">
                    <span><span class="badge-pill b-green">Completed</span></span><strong>@completed (@Pct(completed, apptTotal)%)</strong>
                </div>
                <div style="height:8px;background:#eef1f5;border-radius:999px;overflow:hidden;">
                    <div style="height:100%;width:@Pct(completed, apptTotal)%;background:var(--green);"></div>
                </div>
            </div>
            <div>
                <div style="display:flex;justify-content:space-between;font-size:14px;margin-bottom:6px;">
                    <span><span class="badge-pill b-red">Cancelled</span></span><strong>@cancelled (@Pct(cancelled, apptTotal)%)</strong>
                </div>
                <div style="height:8px;background:#eef1f5;border-radius:999px;overflow:hidden;">
                    <div style="height:100%;width:@Pct(cancelled, apptTotal)%;background:var(--red);"></div>
                </div>
            </div>
        </div>
    </div>

    <div class="panel">
        <div class="panel-head">Billing summary</div>
        <div class="panel-body" style="padding:18px 22px;">
            <div class="list-row" style="justify-content:space-between;">
                <span>Paid invoices</span>
                <strong>@paid (@Pct(paid, invTotal)%)</strong>
            </div>
            <div class="list-row" style="justify-content:space-between;">
                <span>Unpaid invoices</span>
                <strong>@unpaid (@Pct(unpaid, invTotal)%)</strong>
            </div>
            <hr style="border:none;border-top:1px solid var(--line);margin:10px 14px;" />
            <div class="list-row" style="justify-content:space-between;">
                <span style="color:var(--green);font-weight:600;">Revenue collected</span>
                <strong style="color:var(--green);">Rs @Model.TotalRevenue.ToString("N0")</strong>
            </div>
            <div class="list-row" style="justify-content:space-between;">
                <span style="color:var(--amber);font-weight:600;">Outstanding</span>
                <strong style="color:var(--amber);">Rs @Model.OutstandingAmount.ToString("N0")</strong>
            </div>
        </div>
    </div>
</div>

<div class="page-head" style="margin-top:32px;">
    <div>
        <h2 style="font-size:19px;">Analytics</h2>
        <div class="sub">Live charts from the analytics API</div>
    </div>
</div>

<div id="analyticsError" class="alert-box error" style="display:none;">
    Could not load analytics data. Please try again later.
</div>

<div class="stat-grid" style="grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));">
    <div class="panel">
        <div class="panel-head">Patients by gender</div>
        <div class="panel-body" style="padding:18px 22px;">
            <div id="patientsChartLoading" class="chart-loading">Loading…</div>
            <canvas id="patientsChart" height="220" style="display:none;"></canvas>
        </div>
    </div>
    <div class="panel">
        <div class="panel-head">Appointments — last 30 days</div>
        <div class="panel-body" style="padding:18px 22px;">
            <div id="appointmentsChartLoading" class="chart-loading">Loading…</div>
            <canvas id="appointmentsChart" height="220" style="display:none;"></canvas>
        </div>
    </div>
    <div class="panel">
        <div class="panel-head">Appointments per doctor — this month</div>
        <div class="panel-body" style="padding:18px 22px;">
            <div id="doctorsChartLoading" class="chart-loading">Loading…</div>
            <canvas id="doctorsChart" height="220" style="display:none;"></canvas>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.5.0/chart.umd.min.js"></script>
    <script>
        // ---------------------------------------------------------------
        // Analytics charts. Each loader currently returns dummy/mock data
        // shaped exactly like the future API response, so the only change
        // needed once the backend is ready is inside the loadXxx() function
        // (swap the mock object for a real fetch() call to the endpoint
        // noted above each one). UI/rendering code will not need to change.
        // ---------------------------------------------------------------

        const chartColors = {
        teal: '#14a8a0',
        navy: '#134063',
        green: '#1c9e6b',
        amber: '#b8860b',
        red: '#d2493f',
        blue: '#3d7cc9'
        };

        function showChart(canvasId, loadingId) {
        document.getElementById(loadingId).style.display = 'none';
        document.getElementById(canvasId).style.display = 'block';
        }

        function showAnalyticsError() {
        document.getElementById('analyticsError').style.display = 'block';
        }

        // TODO: replace with -> fetch('/api/analytics/patients').then(r => r.json())
        async function loadPatientsByGender() {
        return { labels: ['Male', 'Female', 'Other'], values: [42, 51, 3] };
        }

        // TODO: replace with -> fetch('/api/analytics/appointments').then(r => r.json())
        async function loadAppointmentsLast30Days() {
        const labels = [];
        const values = [];
        for (let i = 29; i >= 0; i--) {
        const d = new Date();
        d.setDate(d.getDate() - i);
        labels.push(d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short' }));
        values.push(Math.floor(Math.random() * 10) + 1);
        }
        return { labels, values };
        }

        // TODO: replace with -> fetch('/api/analytics/doctors').then(r => r.json())
        async function loadAppointmentsPerDoctor() {
        return {
        labels: ['Dr. Ahmed', 'Dr. Fatima', 'Dr. Khan', 'Dr. Raza'],
        values: [18, 24, 11, 9]
        };
        }

        async function initPatientsChart() {
        try {
        const data = await loadPatientsByGender();
        showChart('patientsChart', 'patientsChartLoading');
        new Chart(document.getElementById('patientsChart'), {
        type: 'bar',
        data: {
        labels: data.labels,
        datasets: [{
        label: 'Patients',
        data: data.values,
        backgroundColor: [chartColors.teal, chartColors.navy, chartColors.amber]
        }]
        },
        options: {
        plugins: { legend: { display: false } },
        scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }
        }
        });
        } catch (err) {
        showAnalyticsError();
        }
        }

        async function initAppointmentsChart() {
        try {
        const data = await loadAppointmentsLast30Days();
        showChart('appointmentsChart', 'appointmentsChartLoading');
        new Chart(document.getElementById('appointmentsChart'), {
        type: 'line',
        data: {
        labels: data.labels,
        datasets: [{
        label: 'Appointments',
        data: data.values,
        borderColor: chartColors.teal,
        backgroundColor: 'rgba(20,168,160,0.12)',
        fill: true,
        tension: 0.3,
        pointRadius: 2
        }]
        },
        options: {
        plugins: { legend: { display: false } },
        scales: { y: { beginAtZero: true, ticks: { precision: 0 } }, x: { ticks: { maxTicksLimit: 8 } } }
        }
        });
        } catch (err) {
        showAnalyticsError();
        }
        }

        async function initDoctorsChart() {
        try {
        const data = await loadAppointmentsPerDoctor();
        showChart('doctorsChart', 'doctorsChartLoading');
        new Chart(document.getElementById('doctorsChart'), {
        type: 'pie',
        data: {
        labels: data.labels,
        datasets: [{
        data: data.values,
        backgroundColor: [chartColors.teal, chartColors.navy, chartColors.amber, chartColors.blue]
        }]
        },
        options: {
        plugins: { legend: { position: 'bottom' } }
        }
        });
        } catch (err) {
        showAnalyticsError();
        }
        }

        initPatientsChart();
        initAppointmentsChart();
        initDoctorsChart();
    </script>
}