@model List<Invoice>
@{
    ViewData["Title"] = "Billing";
    var search = ViewBag.Search as string;
    var status = ViewBag.Status as string;
}
<div id="loadingSpinner" style="text-align:center; padding:40px;">
    <div class="spinner" style="width:36px; height:36px; border:4px solid #e0e0e0; border-top-color:#2563eb; border-radius:50%; margin:0 auto; animation: spin 0.8s linear infinite;"></div>
    <p style="color:#888; margin-top:12px; font-size:13px;">Loading invoices...</p>
</div>
<style>
    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }
</style>

<div id="billingContent" style="display:none;">
    <div class="page-head">
    <div>
        <h2>Billing &amp; Invoices</h2>
        <div class="sub">@Model.Count invoice(s)</div>
    </div>
    <a asp-action="AddEdit" class="btn btn-primary">+ New Invoice</a>
</div>

<form asp-action="Index" method="get" class="toolbar">
    <div class="search-group">
        <input type="text" name="search" value="@search" placeholder="Search patient or description..." />
        <button type="submit" class="btn btn-primary">Search</button>
    </div>
    <select name="status" class="filter-select" onchange="this.form.submit()">
        <option value="">All status</option>
        <option value="Paid" selected="@(status == "Paid")">Paid</option>
        <option value="Unpaid" selected="@(status == "Unpaid")">Unpaid</option>
        <option value="Overdue" selected="@(status == "Overdue")">Overdue</option>
    </select>
    @if (!string.IsNullOrEmpty(search) || !string.IsNullOrEmpty(status))
    {
        <a asp-action="Index" class="btn btn-secondary">Clear</a>
    }
</form>

<div class="table-card">
    @if (Model.Any())
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Invoice #</th>
                    <th>Patient</th>
                    <th>Description</th>
                    <th>Amount</th>
                    <th>Issued</th>
                    <th>Status</th>
                    <th style="text-align:right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var i in Model)
                {
                    <tr>
                        <td class="cell-strong">#@i.Id.ToString("D4")</td>
                        <td>@(i.Patient?.FullName ?? "—")</td>
                        <td>@(string.IsNullOrEmpty(i.Description) ? "—" : i.Description)</td>
                        <td class="cell-strong">Rs @i.Amount.ToString("N0")</td>
                        <td>@i.IssuedDate.ToString("MMM dd, yyyy")</td>
                        <td>
                            @if (i.Status == "Paid")
                            {
                                <span class="badge-pill b-green">Paid</span>
                            }
                            else if (i.Status == "Overdue")
                            {
                                <span class="badge-pill b-red">Overdue</span>
                            }
                            else
                            {
                                <span class="badge-pill b-amber">Unpaid</span>
                            }
                        </td>
                        <td style="text-align:right;">
                            <div class="action-group">
                                @if (i.Status != "Paid")
                                {
                                    <form asp-action="MarkPaid" asp-route-id="@i.Id" method="post">
                                        <button type="submit" class="btn btn-success btn-sm">Mark Paid</button>
                                    </form>
                                }
                                <a asp-action="AddEdit" asp-route-id="@i.Id" class="btn btn-outline btn-sm">Edit</a>
                                <form asp-action="Delete" asp-route-id="@i.Id" method="post"
                                      onsubmit="return confirm('Delete this invoice?');">
                                    <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="empty-state">
            <div class="empty-ico">₨</div>
            <h4>No invoices found</h4>
            <p>Create an invoice to start tracking billing.</p>
            <a asp-action="AddEdit" class="btn btn-primary">+ New Invoice</a>
        </div>
    }
</div>
</div>
    <script>
            window.addEventListener('DOMContentLoaded', function() {
                setTimeout(function() {
                    document.getElementById('loadingSpinner').style.display = 'none';
                    document.getElementById('billingContent').style.display = 'block';
                }, 400);
            });
    </script>
