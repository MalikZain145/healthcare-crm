@model AppointmentViewModel
@{
    var isEdit = Model.Id != 0;
    ViewData["Title"] = isEdit ? "Edit Appointment" : "Book Appointment";
    var patients = ViewBag.Patients as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
    var doctors = ViewBag.Doctors as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
}

<div class="page-head">
    <div><h2>@(isEdit ? "Edit Appointment" : "Book Appointment")</h2></div>
    <a asp-action="Index" class="btn btn-secondary">← Back to list</a>
</div>

<div class="card form-card">
    <div class="card-head"><h3>Appointment details</h3></div>
    <div class="form-body">
        <form asp-action="AddEdit" method="post">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="alert-box error"></div>

            <div class="form-grid">
                <div class="form-group">
                    <label asp-for="PatientId" class="form-label"></label>
                    <select asp-for="PatientId" asp-items="patients" class="form-select">
                        <option value="">Select patient</option>
                    </select>
                    <span asp-validation-for="PatientId" class="field-error"></span>
                </div>
                <div class="form-group">
                    <label asp-for="DoctorId" class="form-label"></label>
                    <select asp-for="DoctorId" asp-items="doctors" class="form-select">
                        <option value="">Select doctor</option>
                    </select>
                    <span asp-validation-for="DoctorId" class="field-error"></span>
                </div>
                <div class="form-group">
                    <label asp-for="AppointmentDate" class="form-label"></label>
                    <input asp-for="AppointmentDate" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" class="form-control" />
                    <span asp-validation-for="AppointmentDate" class="field-error"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Status" class="form-label"></label>
                    <select asp-for="Status" class="form-select">
                        <option value="Scheduled">Scheduled</option>
                        <option value="Completed">Completed</option>
                        <option value="Cancelled">Cancelled</option>
                    </select>
                    <span asp-validation-for="Status" class="field-error"></span>
                </div>
                <div class="form-group full">
                    <label asp-for="Reason" class="form-label"></label>
                    <input asp-for="Reason" class="form-control" placeholder="e.g. Routine checkup" />
                    <span asp-validation-for="Reason" class="field-error"></span>
                </div>
                <div class="form-group full">
                    <label asp-for="Notes" class="form-label"></label>
                    <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
                    <span asp-validation-for="Notes" class="field-error"></span>
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">@(isEdit ? "Save changes" : "Book appointment")</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
