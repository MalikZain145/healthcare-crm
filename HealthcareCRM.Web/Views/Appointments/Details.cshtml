@model HealthcareCRM.Web.Models.ViewModels.AppointmentDetailsViewModel
@{
    ViewData["Title"] = "Appointment Details";
    string Badge(string st) => st == "Completed" ? "b-green" : st == "Cancelled" ? "b-red" : "b-blue";
}

<div class="page-head">
    <div><h2>Appointment Details</h2></div>
    <a asp-action="Index" class="btn btn-secondary">← Back</a>
</div>

<div class="panel" style="margin-bottom:20px;">
    <div class="panel-head">Appointment Information</div>
    <div class="panel-body" style="padding:20px 24px;">
        <div class="form-grid">
            <div class="form-group">
                <div class="form-label">Patient</div>
                <div class="cell-strong">@(Model.Appointment.Patient?.FullName ?? "—")</div>
            </div>
            <div class="form-group">
                <div class="form-label">Doctor</div>
                <div class="cell-strong">@(Model.Appointment.Doctor?.FullName ?? "—")</div>
            </div>
            <div class="form-group">
                <div class="form-label">Date</div>
                <div class="cell-strong">@Model.Appointment.AppointmentDate.ToString("dd MMM yyyy")</div>
            </div>
            <div class="form-group">
                <div class="form-label">Time</div>
                <div class="cell-strong">@Model.Appointment.AppointmentDate.ToString("hh:mm tt")</div>
            </div>
            <div class="form-group">
                <div class="form-label">Status</div>
                <span class="badge-pill @Badge(Model.Appointment.Status)">@Model.Appointment.Status</span>
            </div>
            <div class="form-group">
                <div class="form-label">Reason</div>
                <div class="cell-strong">@(string.IsNullOrEmpty(Model.Appointment.Reason) ? "—" : Model.Appointment.Reason)</div>
            </div>
        </div>
    </div>
</div>

<div class="card form-card" style="max-width:none; margin-bottom:20px;">
    <div class="card-head"><h3>Add Prescription</h3></div>
    <div class="form-body">
        <form asp-controller="Prescriptions" asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="AppointmentId" value="@Model.Appointment.Id" />

            <div class="form-grid">
                <div class="form-group">
                    <label class="form-label">Medicine Name</label>
                    <input type="text" name="MedicineName" class="form-control" required />
                </div>
                <div class="form-group">
                    <label class="form-label">Dosage</label>
                    <input type="text" name="Dosage" class="form-control" required />
                </div>
                <div class="form-group">
                    <label class="form-label">Duration</label>
                    <input type="text" name="Duration" class="form-control" required />
                </div>
                <div class="form-group full">
                    <label class="form-label">Instructions</label>
                    <textarea name="Instructions" rows="4" class="form-control"></textarea>
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Save Prescription</button>
            </div>
        </form>
    </div>
</div>

<div class="table-card">
    <div class="panel-head">Prescription History</div>
    @if (Model.Prescriptions.Any())
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Medicine</th>
                    <th>Dosage</th>
                    <th>Duration</th>
                    <th>Instructions</th>
                    <th>Date</th>
                    <th style="text-align:right;">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Prescriptions)
                {
                    <tr>
                        <td class="cell-strong">@item.MedicineName</td>
                        <td>@item.Dosage</td>
                        <td>@item.Duration</td>
                        <td>@(string.IsNullOrEmpty(item.Instructions) ? "—" : item.Instructions)</td>
                        <td>@item.CreatedAt.ToString("dd MMM yyyy")</td>
                        <td style="text-align:right;">
                            <form asp-controller="Prescriptions" asp-action="Delete" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.Id" />
                                <input type="hidden" name="appointmentId" value="@Model.Appointment.Id" />
                                <button type="submit" class="btn btn-danger btn-sm"
                                        onclick="return confirm('Delete this prescription?')">
                                    Delete
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="empty-state">
            <div class="empty-ico">℞</div>
            <h4>No prescriptions yet</h4>
            <p>Add a prescription using the form above.</p>
        </div>
    }
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}